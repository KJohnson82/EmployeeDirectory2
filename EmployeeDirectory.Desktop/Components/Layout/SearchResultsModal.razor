@using EmployeeDirectory.Core.Services
@using Telerik.Blazor
@using Telerik.Blazor.Components
@using Telerik.SvgIcons
@inject EmployeeDirectory.Core.Services.ISearchService SearchService
@inject NavigationManager Navigation

@* FILE: SearchResultsModal.razor
   PURPOSE: Modal window to display search results (Employees, Departments, Locations).
   NOTE: UI-related classes are documented above the corresponding elements so you can
         change colors/spacing in CSS without hunting through markup. *@

@* Root modal window component.
   - Change overall modal appearance via the `.search-modal` class and `.k-window` styles.
   - Telerik window props control size/behavior (Width/Height/Draggable/Modal). *@
<TelerikWindow Class="search-modal k-colors-secondary"
               Width="350px"
               Height="600px"
               Draggable="false"
               Modal="true"
               Visible="@IsVisible"
               Resizable="false"
               VisibleChanged="@OnVisibleChanged">

    @* Window title area / header
       - Visual styling lives in `.k-window-titlebar` and `.search-results-header`.
       - Change background / text colors there. *@
    <WindowTitle>
        <div class="search-results-header k-d-flex k-align-items-center k-gap-2 ">
            <strong>Search Results</strong>

            @* Inline search term display.
               - Style via `.search-term` to change text color/italic/spacing. *@
            @if (!string.IsNullOrEmpty(SearchResults?.SearchTerm))
            {
                <span class="search-term k-text-subtle">for "@SearchResults.SearchTerm"</span>
            }
        </div>
    </WindowTitle>

    @* Main scrollable content area
       - `.search-results-container` holds either loader / tabs / no-results.
       - Adjust container background / padding / height here. *@
    <WindowContent>
        <div class="search-results-container k-h-full">
            @* Loading indicator block
               - Uses TelerikLoader; change loader appearance with ThemeConstants or Kendo CSS variables. *@
            @if (IsSearching)
            {
                <div class="k-d-flex k-flex-col k-align-items-center k-justify-content-center k-gap-4 k-p-8">
                    <TelerikLoader Visible="true" Size="@ThemeConstants.Loader.Size.Medium" />
                    <p class="k-text-center k-text-subtle">Searching...</p>
                </div>
            }
            @* Results present: tabbed interface
               - `TelerikTabStrip` and `.k-tabstrip` CSS control the tab visuals.
               - To change active tab color, target selectors like `.k-tabstrip .k-tabstrip-items-wrapper .k-item.k-selected` etc. *@
            else if (SearchResults?.HasResults == true)
            {
                <TelerikTabStrip Width="95%" TabAlignment="TabStripTabAlignment.Stretched" PersistTabContent="true" Class="search-tabstrip" >

                    @* Employees tab
                       - Each employee item uses `.result-item` and `.employee-item`.
                       - Change hover, border, and typography in the CSS section below. *@
                    <TabStripTab Title="@($"Employees ({SearchResults.Employees.Count})")" Class="tab-header" >
                        <div class="results-section k-overflow-y-auto k-h-full">
                            @foreach (var employee in SearchResults.Employees)
                            {
                                @* Single result row
                                   - `.result-header` contains main title and metadata.
                                   - `.job-title` / small text styles located in CSS. *@
                                <div class="result-item k-p-4 k-cursor-pointer k-border-b k-border-b-solid k-border-border" @onclick="() => NavigateToEmployee(employee.Id)">
                                    <div class="k-d-flex k-flex-col k-gap-2">
                                        <div class="k-font-weight-semibold k-text-primary">@employee.FirstName @employee.LastName</div>
                                        <div class="k-text-subtle k-font-size-md">@employee.JobTitle</div>
                                        <div class="k-text-subtle k-font-size-md">@employee.EmpDepartment?.DeptName</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </TabStripTab>

                    @* Departments tab
                       - Department list items use `.department-item`.
                       - To change the accent for departments, update `.department-item:hover` in CSS. *@
                    <TabStripTab Title="@($"Departments ({SearchResults.Departments.Count})")" Class="tab-header">
                        <div class="results-section k-overflow-y-auto k-h-full">
                            @foreach (var department in SearchResults.Departments)
                            {
                                <div class="result-item k-p-4 k-cursor-pointer k-border-b k-border-b-solid k-border-border" @onclick="() => NavigateToDepartment(department.Id)">
                                    <div class="k-d-flex k-flex-col k-gap-2">
                                        <div class="k-font-weight-semibold k-text-primary">@department.DeptName</div>
                                        <div class="k-text-subtle k-font-size-sm">@department.DeptLocation.LocName</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </TabStripTab>

                    @* Locations tab
                       - Location items use `.location-item`.
                       - Address/secondary text is `.k-text-subtle k-font-size-sm`. *@
                    <TabStripTab Title="@($"Locations ({SearchResults.Locations.Count})")" Class="tab-header">
                        <div class="results-section k-overflow-y-auto k-h-full">
                            @foreach (var location in SearchResults.Locations)
                            {
                                <div class="result-item k-p-4 k-cursor-pointer k-border-b k-border-b-solid k-border-border" @onclick="() => NavigateToLocation(location.Id)">
                                    <div class="k-d-flex k-flex-col k-gap-2">
                                        <div class="k-font-weight-semibold k-text-primary">@location.LocName</div>
                                        <div class="k-text-subtle k-font-size-sm">@location.City</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </TabStripTab>
                </TelerikTabStrip>
            }
            @* Empty / no-results UI
               - `.no-results` controls the empty-state visuals. *@
            else
            {
                <div class="k-d-flex k-flex-col k-align-items-center k-justify-content-center k-gap-4 k-p-8 k-h-full">
                    <div class="k-text-center k-text-subtle k-font-size-lg">No results found</div>
                    <div class="k-text-center k-text-subtle k-font-size-sm">Try adjusting your search terms</div>
                </div>
            }
        </div>
    </WindowContent>

    @* Window actions area (footer actions)
       - Close button is a `WindowAction` which triggers `CloseModal`.
       - Styling for actions typically lives in `.k-window-actions` / Kendo variables. *@
    <WindowActions>
        <WindowAction Name="Close" OnClick="@CloseModal" />
    </WindowActions>
</TelerikWindow>

@code {
    // Parameters / state (no UI comments needed here)
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    [Parameter]
    public string SearchTerm { get; set; } = "";

    private SearchResults? SearchResults { get; set; }
    private bool IsSearching { get; set; }


    // private void NavigateToEmployee(int id)
    // {
    //     Console.WriteLine($"Navigate to employee: {id}");
    //     IsVisible = false;
    // }

    // private void NavigateToDepartment(int id)
    // {
    //     Console.WriteLine($"Navigate to department: {id}");
    //     IsVisible = false;
    // }

    // private void NavigateToLocation(int id)
    // {
    //     Console.WriteLine($"Navigate to location: {id}");
    //     IsVisible = false;
    // }

    public class EmployeeResult
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Position { get; set; }
        public string Department { get; set; }
    }

    public class DepartmentResult
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public int EmployeeCount { get; set; }
    }

    public class LocationResult
    {
        public int Id { get; set; }
        public string Name { get; set; }
        public string Address { get; set; }
    }

    // Search lifecycle / service integration
    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && !string.IsNullOrWhiteSpace(SearchTerm) &&
            (SearchResults?.SearchTerm != SearchTerm))
        {
            await PerformSearch();
        }
    }

    private async Task PerformSearch()
    {
        IsSearching = true;
        StateHasChanged();

        try
        {
            SearchResults = await SearchService.SearchAllAsync(SearchTerm);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Search error: {ex.Message}");
            SearchResults = new EmployeeDirectory.Core.Services.SearchResults { SearchTerm = SearchTerm };
        }
        finally
        {
            IsSearching = false;
            StateHasChanged();
        }
    }

    private async Task OnVisibleChanged(bool isVisible)
    {
        await IsVisibleChanged.InvokeAsync(isVisible);
    }

    private async Task CloseModal()
    {
        await IsVisibleChanged.InvokeAsync(false);
    }

    // Navigate to employee detail page within department context
    private void NavigateToEmployee(int employeeId)
    {
        CloseModal();

        var employee = SearchResults?.Employees.FirstOrDefault(e => e.Id == employeeId);

        if (employee?.Department != null)
        {
            Navigation.NavigateTo($"/corporate/{employee.Department}/{employeeId}");
        }
        else
        {
            Navigation.NavigateTo($"/corporate");
        }
    }

    // Navigate to location detail page based on location type
    private void NavigateToLocation(int locationId)
    {
        CloseModal();

        var location = SearchResults?.Locations.FirstOrDefault(l => l.Id == locationId);

        if (location == null)
        {
            Navigation.NavigateTo("/");
            return;
        }

        switch (location.Loctype)
        {
            case EmployeeDirectory.Core.Enums.Loctype.MetalMart:
                Navigation.NavigateTo($"/metalmart/{locationId}");
                break;
            case EmployeeDirectory.Core.Enums.Loctype.ServiceCenter:
                Navigation.NavigateTo($"/servicecenter/{locationId}");
                break;
            case EmployeeDirectory.Core.Enums.Loctype.Plant:
                Navigation.NavigateTo($"/plant/{locationId}");
                break;
            default:
                Navigation.NavigateTo("/");
                break;
        }
    }

    // Navigate to department detail page based on location context
    private void NavigateToDepartment(int departmentId)
    {
        CloseModal();

        var department = SearchResults?.Departments.FirstOrDefault(d => d.Id == departmentId);

        if (department?.Location != null)
        {
            // Location ID 1 = corporate headquarters
            if (department.Location == 1)
            {
                Navigation.NavigateTo($"/corporate/{departmentId}");
            }
            else
            {
                Navigation.NavigateTo($"/plant/{department.Location}/{departmentId}");
            }
        }
        else
        {
            Navigation.NavigateTo($"/corporate/{departmentId}");
        }
    }
}
